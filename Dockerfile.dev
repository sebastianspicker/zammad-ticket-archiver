# Provide the full editable toolchain used by the source-mounted development service.
FROM python:3.14.6-slim@sha256:7bec7ddcddeff7975d6ba9b4be7dd6f6b2f55e7491539145e2978f7f97ce9144

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# System deps (WeasyPrint + basic tooling)
# Unpinned on purpose: the base image is pinned by digest, and Debian drops old package
# versions on security updates, so version pins would break rebuilds.
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    bash \
    libcairo2 \
    libffi-dev \
    libgdk-pixbuf-2.0-0 \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    fonts-dejavu-core \
    shared-mime-info \
  && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE CHANGELOG.md /app/
COPY src/ /app/src/
COPY requirements/ /app/requirements/

RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements/tools.lock \
  && python -m pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements/dev.lock \
  && python -m pip install --no-cache-dir --no-deps --no-build-isolation -e .

RUN addgroup --system --gid 10001 app \
  && adduser --system --uid 10001 --ingroup app --home /nonexistent --shell /usr/sbin/nologin app \
  && install -d -m 0700 -o app -g app /mnt/archive /var/lib/chronikwerk/admin

USER app:app

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=10 \
  CMD python -c "import os,urllib.request; p=os.getenv('SERVER__PORT','8080'); urllib.request.urlopen(f'http://127.0.0.1:{p}/healthz', timeout=2).read()"

CMD ["chronikwerk"]
